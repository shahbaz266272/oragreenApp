# ==================== ENVIRONMENT ====================
NODE_ENV=development
PORT=3000
DEBUG=false

# ==================== DATABASE ====================
MONGODB_URI=mongodb://localhost:27017/oragreen
MONGODB_USER=
MONGODB_PASSWORD=

# ==================== FIREBASE ADMIN SDK ====================
# Option 1: Specify service account JSON as environment variable
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"xxx","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk@your-project.iam.gserviceaccount.com"}

# Option 2: OR specify path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-adminsdk.json

# ==================== JWT ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,exp://

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== EMAIL (Optional) ====================
EMAIL_FROM=noreply@oragreen.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ==================== EXPO PUSH (if using Expo) ====================
# Automatically used by Expo SDK (no config needed)

# ==================== PAYMENT GATEWAY (Optional) ====================
STRIPE_SECRET_KEY=sk_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# ==================== AWS (Optional) ====================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==================== CACHE (Optional) ====================
REDIS_URL=redis://localhost:6379

# ==================== NOTIFICATION SPECIFIC ====================
# Batch size for bulk notifications
NOTIFICATION_BATCH_SIZE=10

# Delay between batches (ms)
NOTIFICATION_BATCH_DELAY=100

# Max retries for failed notifications
NOTIFICATION_MAX_RETRIES=3

# ==================== API KEYS ====================
# Third-party service keys
API_KEY_MAPS=
API_KEY_SMS=
